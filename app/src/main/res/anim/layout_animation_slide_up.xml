<?xml version="1.0" encoding="utf-8"?>
<!--
    LayoutAnimation del RecyclerView: aplica item_slide_up a cada hijo con un pequeño
    retraso entre uno y otro (delay = 15 % de la duración), así las tarjetas van
    apareciendo en cascada de arriba a abajo.
-->
<layoutAnimation xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/item_slide_up"
    android:animationOrder="normal"
    android:delay="15%" />
