<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una película en la cartelera: icono, título, género, estrellas y sinopsis corta -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:rippleColor="@color/gold_dark"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivMovieIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_movie_icon"
            android:contentDescription="@null"
            android:padding="14dp"
            android:src="@drawable/ic_movie"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivMovieIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Dune: Parte Dos" />

        <TextView
            android:id="@+id/tvMovieGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_genre_tag"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvMovieTitle"
            app:layout_constraintTop_toBottomOf="@id/tvMovieTitle"
            tools:backgroundTint="@color/genre_sci_fi"
            tools:text="Ciencia ficción" />

        <RatingBar
            android:id="@+id/rbMovieRating"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:isIndicator="true"
            android:numStars="5"
            android:progressTint="@color/gold"
            android:secondaryProgressTint="@color/gold"
            android:progressBackgroundTint="@color/text_secondary"
            android:stepSize="0.5"
            app:layout_constraintBottom_toBottomOf="@id/tvMovieGenre"
            app:layout_constraintStart_toEndOf="@id/tvMovieGenre"
            app:layout_constraintTop_toTopOf="@id/tvMovieGenre"
            tools:rating="4.5" />

        <!-- Sinopsis corta: se recorta a 3 líneas con puntos suspensivos -->
        <TextView
            android:id="@+id/tvMovieSynopsis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivMovieIcon"
            tools:text="Paul Atreides se une a Chani y a los Fremen mientras busca venganza contra los conspiradores que destruyeron a su familia." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
