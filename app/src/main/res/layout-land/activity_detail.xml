<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle en horizontal: cabecera a la izquierda y ficha a la derecha.
     Detalle de una película: cabecera con título, género y valoración, datos y sinopsis completa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.DetailActivity">

    <include layout="@layout/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Cabecera -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/gold_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivDetailIcon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_movie_icon"
                        android:contentDescription="@null"
                        android:padding="22dp"
                        android:src="@drawable/ic_movie" />

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/gold"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Dune: Parte Dos" />

                    <TextView
                        android:id="@+id/tvDetailGenre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_genre_tag"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:backgroundTint="@color/genre_sci_fi"
                        tools:text="Ciencia ficción" />

                    <RatingBar
                        android:id="@+id/rbDetailRating"
                        style="@style/Widget.AppCompat.RatingBar.Indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:progressBackgroundTint="@color/text_secondary"
                        android:progressTint="@color/gold"
                        android:secondaryProgressTint="@color/gold"
                        android:stepSize="0.5"
                        tools:rating="4.5" />

                    <TextView
                        android:id="@+id/tvDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="4,5 / 5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="3"
                android:orientation="vertical">

                <!-- Datos -->
                <TextView
                    style="@style/TextAppearance.IPeliculas.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/detail_info" />

                <TextView
                    style="@style/TextAppearance.IPeliculas.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_director" />

                <TextView
                    android:id="@+id/tvDetailDirector"
                    style="@style/TextAppearance.IPeliculas.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Denis Villeneuve" />

                <TextView
                    style="@style/TextAppearance.IPeliculas.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_release_date" />

                <TextView
                    android:id="@+id/tvDetailReleaseDate"
                    style="@style/TextAppearance.IPeliculas.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="01/03/2024" />

                <TextView
                    style="@style/TextAppearance.IPeliculas.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_duration" />

                <TextView
                    android:id="@+id/tvDetailDuration"
                    style="@style/TextAppearance.IPeliculas.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="166 min" />

                <!-- Sinopsis completa -->
                <TextView
                    style="@style/TextAppearance.IPeliculas.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_synopsis" />

                <TextView
                    android:id="@+id/tvDetailSynopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    tools:text="Paul Atreides se une a Chani y a los Fremen..." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
