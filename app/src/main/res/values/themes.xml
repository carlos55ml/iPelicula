<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema de la app. Siempre oscuro (tema cinematográfico), por eso hereda de
        Material3.Dark y no hay versión values-night.
    -->
    <style name="Base.Theme.IPeliculas" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.IPeliculas" parent="Base.Theme.IPeliculas" />

    <!-- Textos de la pantalla de detalle -->
    <style name="TextAppearance.IPeliculas.SectionTitle" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IPeliculas.Label" parent="">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.IPeliculas.Value" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
